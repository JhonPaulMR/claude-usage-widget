{
  "name": "claude-usage-widget",
  "version": "0.1.0",
  "description": "Widget fixo na lateral direita com os limites de uso do Claude (sessão de 5h e semanal).",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "probe": "node scripts/probe.js",
    "icons": "node scripts/make-icons.js",
    "test": "node --test \"test/*.test.js\"",
    "dist": "npm run icons && electron-builder --win nsis"
  },
  "build": {
    "appId": "br.com.superdalpozzo.claude-usage-widget",
    "productName": "Claude Usage Widget",
    "files": [
      "src/**/*",
      "build/*.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  }
}
